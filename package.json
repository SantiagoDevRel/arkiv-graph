{
  "name": "arkiv-graph-monorepo",
  "version": "0.0.0",
  "private": true,
  "description": "Interactive graphs and tables for Arkiv entities. Library and sample.",
  "type": "module",
  "packageManager": "pnpm@9.12.0",
  "engines": {
    "node": ">=22 <23"
  },
  "scripts": {
    "build:lib": "pnpm --filter arkiv-graph build",
    "build:example": "pnpm --filter @arkiv-graph/example build",
    "build": "pnpm build:lib && pnpm build:example",
    "dev": "pnpm --filter @arkiv-graph/example dev",
    "test": "pnpm --filter arkiv-graph test",
    "seed": "pnpm --filter @arkiv-graph/example seed",
    "test:wallet": "vitest run apps/example/src/lib/wallet-client.test.ts",
    "typecheck": "pnpm --filter arkiv-graph typecheck && pnpm --filter @arkiv-graph/example exec tsc --noEmit"
  },
  "pnpm": {
    "overrides": {
      "ws@>=8.0.0 <8.21.0": "^8.21.0",
      "postcss@<8.5.23": "^8.5.28",
      "nanoid@>=3 <3.3.18": "^3.3.18",
      "sharp@<0.35.0": "^0.35.4"
    }
  },
  "license": "MIT"
}
